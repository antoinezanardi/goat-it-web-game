{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "rangeStrategy": "bump",
  "assignees": [
    "antoinezanardi"
  ],
  "baseBranchPatterns": [
    "develop"
  ],
  "semanticCommits": "enabled",
  "reviewers": [
    "antoinezanardi"
  ],
  "dependencyDashboardApproval": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pnpm version installed in the Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["npm install -g pnpm@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    }
  ]
}
