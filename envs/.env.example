# Base URL of the Goat It API server
NUXT_GOAT_IT_API_BASE_URL=http://localhost:9090
# Game key used to authenticate requests to the Goat It API
NUXT_GOAT_IT_API_GAME_KEY=your_game_key_here
# Default locale for the application (used by @nuxtjs/i18n)
NUXT_PUBLIC_DEFAULT_LOCALE=en
# Base URL of the Goat It Web Game site (used by nuxt-site-config)
NUXT_PUBLIC_SITE_URL=https://goat-it.fr
# Application secret used to sign nuxt-og-image URLs (minimum 32 characters, must match the one used at build time and runtime)
NUXT_APP_SECRET=your_app_secret_here_must_be_at_least_32_chars
