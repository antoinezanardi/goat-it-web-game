# Base URL of the Goat It API server
# Must use https in production (loopback and internal hosts are exempt)
NUXT_GOAT_IT_API_BASE_URL=http://localhost:9090
# Game key used to authenticate requests to the Goat It API
NUXT_GOAT_IT_API_GAME_KEY=your_game_key_here
# Default locale for the application (used by @nuxtjs/i18n)
NUXT_PUBLIC_DEFAULT_LOCALE=en
# Base URL of the Goat It Web Game site (used by nuxt-site-config)
NUXT_PUBLIC_SITE_URL=https://goat-it.fr
# Site environment used by nuxt-site-config for indexability (production is indexable, staging is not)
# This file is for deployment configuration: production must use "production" and staging must use "staging"
# Local development uses envs/.env.development instead of this file
NUXT_SITE_ENV=production
# Maximum number of proxy requests allowed per client per rate limit window
NUXT_RATE_LIMIT_MAXIMUM_REQUESTS=60
# Rate limit window duration in milliseconds
NUXT_RATE_LIMIT_WINDOW_IN_MS=60000
# Trust the first X-Forwarded-For entry (requires the reverse proxy to overwrite the header)
NUXT_RATE_LIMIT_TRUST_PROXY=false
# Content Security Policy mode: enforce, report-only or off
NUXT_SECURITY_CSP_MODE=enforce
