# Base URL of the Goat It API server (test environment)
NUXT_GOAT_IT_API_BASE_URL=http://localhost:9090
# Game key used to authenticate requests to the Goat It API (test value)
NUXT_GOAT_IT_API_GAME_KEY=test_game_api_key_for_testing
# Default locale for the application (used by @nuxtjs/i18n)
NUXT_PUBLIC_DEFAULT_LOCALE=en
# Base URL of the Goat It Web Game site (test environment)
NUXT_PUBLIC_SITE_URL=https://test.goat-it.fr
# Acceptance builds cover the non-indexable staging behavior; production SEO coverage is tracked in #537
NUXT_SITE_ENV=staging
# Maximum number of proxy requests allowed per client per rate limit window
NUXT_RATE_LIMIT_MAXIMUM_REQUESTS=60
# Rate limit window duration in milliseconds
NUXT_RATE_LIMIT_WINDOW_IN_MS=60000
# Acceptance scenarios target dedicated clients through X-Forwarded-For
NUXT_RATE_LIMIT_TRUST_PROXY=true
# Acceptance scenarios assert the enforced policy
NUXT_SECURITY_CSP_MODE=enforce

# Structured server log level
NUXT_LOGGER_LEVEL=info

# Acceptance builds must not contact Sentry
NUXT_PUBLIC_SENTRY_DISABLED=true
