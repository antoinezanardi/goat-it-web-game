{
  "name": "goat-it-web-game",
  "version": "1.3.0",
  "description": "Goat It Web Game is a web game for the Goat It app.",
  "private": true,
  "type": "module",
  "keywords": [
    "goat-it",
    "web",
    "game",
    "nuxt",
    "vue",
    "javascript",
    "typescript"
  ],
  "homepage": "https://github.com/antoinezanardi/goat-it-web-game#readme",
  "bugs": {
    "url": "https://github.com/antoinezanardi/goat-it-web-game/issues",
    "email": "antoine.zanardi@epitech.eu"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antoinezanardi/goat-it-web-game.git",
    "branch": "main"
  },
  "license": "MIT",
  "author": "Antoine ZANARDI",
  "engines": {
    "node": ">=26.7.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "packageManager": "pnpm@11.22.0",
  "imports": {
    "#acceptance/*": "./tests/acceptance/*",
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "prepare": "scripts/post-install-prepare.sh",
    "build": "nuxt build",
    "dev": "nuxt dev --dotenv envs/.env.development --port 4000",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "start:dev": "pnpm run dev",
    "start:prod": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:fix": "pnpm run lint:oxlint:fix && pnpm run lint:eslint:fix",
    "lint:staged:fix": "pnpm run lint:oxlint:staged:fix && pnpm run lint:eslint:staged:fix",
    "lint:eslint": "eslint --config eslint.config.ts",
    "lint:eslint:fix": "eslint --config eslint.config.ts --fix",
    "lint:eslint:staged:fix": "lint-staged -c configs/lint-staged/.lintstagedrc.eslint.json",
    "lint:eslint:inspect-config": "config-inspector",
    "lint:oxlint": "oxlint -c oxlint.config.jsonc",
    "lint:oxlint:fix": "oxlint -c oxlint.config.jsonc --fix --fix-suggestions",
    "lint:oxlint:check-rules": "node scripts/check-oxlint-rules.ts",
    "lint:oxlint:staged:fix": "lint-staged -c configs/lint-staged/.lintstagedrc.oxlint.json",
    "test": "pnpm run test:unit:cov",
    "test:unit": "cross-env NODE_OPTIONS='--no-webstorage' vitest --config configs/vitest/vitest.config.ts",
    "test:unit:watch": "cross-env NODE_OPTIONS='--no-webstorage' vitest --config configs/vitest/vitest.config.ts --watch",
    "test:unit:cov": "cross-env NODE_OPTIONS='--no-webstorage' vitest --config configs/vitest/vitest.config.ts --coverage",
    "test:unit:staged": "lint-staged -c configs/lint-staged/.lintstagedrc.unit-tests.json",
    "test:acceptance:prepare": "playwright install --with-deps chromium",
    "test:acceptance:build": "nuxi build --envName test --dotenv envs/.env.test",
    "test:acceptance": "pnpm run test:acceptance:build && cucumber-js --config configs/cucumber/cucumber.json",
    "test:acceptance:skip-build": "cucumber-js --config configs/cucumber/cucumber.json",
    "docker:build": "docker buildx build --load -t goat-it-web-game .",
    "docker:build:linux/arm64": "docker buildx build --platform linux/arm64 --load -t goat-it-web-game .",
    "docker:build:linux/amd64": "docker buildx build --platform linux/amd64 --load -t goat-it-web-game .",
    "docker:api-sandbox:start": "docker compose -f docker/goat-it-api-sandbox/docker-compose.yml up -d",
    "docker:api-sandbox:stop": "docker compose -f docker/goat-it-api-sandbox/docker-compose.yml down",
    "docker:api-sandbox:restart": "pnpm run docker:api-sandbox:stop && pnpm run docker:api-sandbox:start",
    "docker:api-sandbox:reset": "pnpm run docker:api-sandbox:stop && docker compose -f docker/goat-it-api-sandbox/docker-compose.yml down -v && pnpm run docker:api-sandbox:start",
    "docker:api-sandbox:update": "docker compose -f docker/goat-it-api-sandbox/docker-compose.yml pull api-0 api-1 api-2 api-3 && pnpm run docker:api-sandbox:restart",
    "script:create-branch": "scripts/create-git-branch.sh",
    "script:create-pull-request": "scripts/create-pull-request.sh",
    "script:create-release-changelog": "scripts/create-release-changelog.sh",
    "script:clean-pr-description": "scripts/clean-pr-description.sh",
    "validate:branch-name": "(cd configs/validate-branch-name && validate-branch-name)"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/config-conventional": "^21.2.2",
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/config-inspector": "^3.2.0",
    "@faker-js/faker": "^10.6.0",
    "@goat-it/schemas": "^0.0.20",
    "@iconify-json/lucide": "^1.2.123",
    "@nuxt/content": "^3.15.2",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/hints": "^1.1.4",
    "@nuxt/test-utils": "^4.1.0",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/robots": "^6.1.4",
    "@nuxtjs/sitemap": "^8.3.4",
    "@pinia/nuxt": "^1.0.2",
    "@pinia/testing": "^2.0.1",
    "@playwright/test": "^1.62.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@takumi-rs/core": "^2.9.2",
    "@tanstack/vue-table": "^9.1.2",
    "@types/node": "^25.9.5",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "commitlint": "^21.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-oxlint": "^1.78.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "fuse.js": "^7.5.0",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.3.0",
    "mongodb": "^7.5.0",
    "nuxt": "^4.5.2",
    "nuxt-og-image": "^6.7.8",
    "nuxt-schema-org": "^6.2.9",
    "nuxt-seo-utils": "^8.4.2",
    "nuxt-site-config": "^4.2.2",
    "nuxtseo-layer-devtools": "^5.3.12",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pinia": "^4.0.3",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "radashi": "^12.9.1",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "semantic-release-export-data": "^1.2.0",
    "tailwindcss": "^4.3.3",
    "type-fest": "^5.8.0",
    "typescript": "^6.0.3",
    "v-gsap-nuxt": "^1.5.12",
    "validate-branch-name": "^1.3.2",
    "vitest": "^4.1.10",
    "vue-component-type-helpers": "^3.3.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.10",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
